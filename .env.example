# ---- Project / runtime ----
COMPOSE_PROJECT_NAME=taktgeber

# ---- hl-gateway ----
HL_GATEWAY_APP_ENV=development
HL_GATEWAY_LOG_LEVEL=INFO
HL_GATEWAY_HYPERLIQUID_BASE_URL=https://api.hyperliquid-testnet.xyz
HL_GATEWAY_HYPERLIQUID_WS_URL=wss://api.hyperliquid-testnet.xyz/ws
HL_GATEWAY_HYPERLIQUID_PRIVATE_KEY=
HL_GATEWAY_HYPERLIQUID_ACCOUNT_ADDRESS=
HL_GATEWAY_REDIS_URL=redis://redis:6379/0
HL_GATEWAY_REQUEST_TIMEOUT_SECONDS=10
HL_GATEWAY_WS_RECONNECT_INITIAL_SECONDS=1
HL_GATEWAY_WS_RECONNECT_MAX_SECONDS=30
HL_GATEWAY_MOCK_TRADING=true

# ---- postgres ----
POSTGRES_DB=taktgeber
POSTGRES_USER=taktgeber
POSTGRES_PASSWORD=change-me

# ---- tg-bot ----
BOT_KEY=
